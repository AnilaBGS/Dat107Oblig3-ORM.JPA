<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             version="3.0">

    <persistence-unit name="ansattPU">

        <class>org.example.model.Ansatt</class>
        <class>org.example.model.Avdeling</class>

        <properties>
            <!-- Database connection -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://ider-database.westeurope.cloudapp.azure.com:5433/h669834"/>

            <property name="jakarta.persistence.jdbc.user" value="h669834"/>
            <property name="jakarta.persistence.jdbc.password" value="pass"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <!-- Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.format_sql" value="true"/>

        </properties>

    </persistence-unit>
</persistence>